# =====================================================================
#  .gitignore - Unity XR project (OpenXR / XR Interaction Toolkit / Meta Quest)
#  Patterns starting with /*/ apply to every Unity project folder in
#  this repo (unity/, XR_SmartHouse/, ...) as well as the repo root.
# =====================================================================

# ---------------------------------------------------------------------
#  Unity generated folders (regenerated by the editor - never commit)
# ---------------------------------------------------------------------
/[Ll]ibrary/
/*/[Ll]ibrary/
/[Tt]emp/
/*/[Tt]emp/
/[Oo]bj/
/*/[Oo]bj/
/[Bb]uild/
/*/[Bb]uild/
/[Bb]uilds/
/*/[Bb]uilds/
/[Ll]ogs/
/*/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/*/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/*/[Mm]emoryCaptures/
/[Rr]ecordings/
/*/[Rr]ecordings/

# Editor auto-save / crash recovery
**/Assets/_Recovery/
**/Assets/_Recovery.meta
**/Assets/SceneDependencyCache*

# Asset Store tools & Unity plugin caches
**/Assets/AssetStoreTools*
**/Assets/Plugins/Editor/JetBrains*
**/Assets/AddressableAssetsData/*/*.bin*
**/Assets/StreamingAssets/aa.meta
**/Assets/StreamingAssets/aa/*

# Autogenerated Jetbrains Rider plugin / exported meshes
/*/[Aa]ssets/Plugins/Editor/JetBrains*
ExportedObj/
.consulo/

# ---------------------------------------------------------------------
#  IDE / generated solution files (Unity regenerates these)
# ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------------
#  Builds - Android / Meta Quest (APK sideload builds)
# ---------------------------------------------------------------------
*.apk
*.aab
*.obb
*.unitypackage
*.app
*.symbols.zip
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
crashlytics-buildid.txt
sysinfo.txt

# Android signing keys - keep these out of the repo
*.keystore
*.jks
user.keystore

# Exported Android Studio / Gradle projects
/*/[Aa]ndroid[Ee]xport/
/*/[Gg]radle[Pp]roject/

# ---------------------------------------------------------------------
#  XR / VR specific
# ---------------------------------------------------------------------
# XR Plugin Management & OpenXR settings in Assets/XR/ ARE committed.
# Only machine-local / generated XR files are ignored here.
**/Assets/XR/Temp/
**/Assets/XR/Temp.meta
# Meta / Oculus SDK local caches (if the Meta XR SDK is added later)
**/Assets/Oculus/OculusProjectConfig.asset.bak
**/Assets/Oculus/VR/Editor/OVRBuildConfig*.asset
**/Assets/Plugins/Android/*.gradle.bak
# Meta Quest Developer Hub / adb captures
*.ovrstats
*.mp4.tmp

# ---------------------------------------------------------------------
#  Secrets - Home Assistant login & token
# ---------------------------------------------------------------------
.env
.env.*
ha_token.txt
ha_token.txt.meta

# ---------------------------------------------------------------------
#  Blender backups
# ---------------------------------------------------------------------
*.blend1
*.blend2
*.blend1.meta
*.blend2.meta

# ---------------------------------------------------------------------
#  OS junk
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
Thumbs.db.meta
ehthumbs.db
desktop.ini

# Unity test output
TestResults/
